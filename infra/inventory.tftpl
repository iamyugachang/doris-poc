# generated by terraform apply — do not edit
[doris]
%{ for n in nodes ~}
${n.name} ansible_host=${n.external_ip} internal_ip=${n.internal_ip} zone=${n.zone} fe_seed=${n.seed ? "true" : "false"}
%{ endfor ~}

[client]
${client.name} ansible_host=${client.external_ip} internal_ip=${client.internal_ip} zone=${client.zone}

[all:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=~/.ssh/google_compute_engine
seed_internal_ip=${nodes[0].internal_ip}
